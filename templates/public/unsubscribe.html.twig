{% extends '@PhpListFrontend/base.html.twig' %}

{% block head %} {{ header|raw }} {% endblock %}

{% block title %}{{ data['title']|default(language_texts.strSubscribeTitle|default('Subscribe')) }}{% endblock %}

{% block body %}
    <div class="legacy-page-shell">
        <section class="legacy-card">
            {% if data['header'] is defined and data['header'] is not empty %}
                <div class="legacy-html-text">{{ data['header']|raw }}</div>
            {% endif %}

            {% if data['intro'] is defined and data['intro'] is not empty %}
                <div class="legacy-html-text">{{ data['intro']|raw }}</div>
            {% endif %}

            {% if form_errors is not empty %}
                <div class="legacy-error-box">
                    {% for error in form_errors %}
                        <p>{{ error }}</p>
                    {% endfor %}
                </div>
            {% endif %}

            {% if success_html %}
                <div class="legacy-html-text">{{ success_html|raw }}</div>
            {% else %}
                <form method="post" action="{{ path('public_unsubscribe', { pageId: page_id }) }}" class="legacy-form" novalidate>
                    <div>{{ language_texts.strUnsubscribeTitle|default('Unsubscribe') }}</div>
                    <div class="legacy-field-group">
                        <label class="legacy-label" for="email">{{ language_texts.strForwardEnterEmail|default('Email') }} *</label>
                        <input id="email" name="email" type="email" class="legacy-input" value="{{ form_data.email|default('') }}" required autocomplete="email">
                    </div>

                    <button type="submit" class="legacy-button">{{ data['button']|default(language_texts.strContinue|default('Unsubscribe')) }}</button>
                </form>
            {% endif %}

            {% if data['footer'] is defined and data['footer'] is not empty %}
                <div class="legacy-html-text">{{ data['footer']|raw }}</div>
            {% endif %}
        </section>
    </div>

    <style>
        body {
            margin: 0;
            background: #f3f3f3;
            color: #2f2f2f;
            font-family: Arial, Helvetica, sans-serif;
        }

        .legacy-page-shell {
            padding: 22px 14px 36px;
        }

        .legacy-card {
            background: #dcdcdc;
            border: 2px solid #767676;
            margin: 0 auto;
            max-width: 780px;
            padding: 24px;
        }

        .legacy-form {
            background: #e6e6e6;
            border: 1px solid #c8c8c8;
            margin-bottom: 18px;
            padding: 14px;
        }

        .legacy-html-text {
            color: #555;
            font-size: 13px;
            line-height: 1.45;
            margin-bottom: 14px;
        }

        .legacy-required-note {
            color: #be2f2f;
            font-size: 12px;
            font-weight: 700;
            margin: 10px 0 14px;
        }

        .legacy-field-group {
            margin-bottom: 12px;
        }

        .legacy-label {
            color: #be2f2f;
            display: block;
            font-size: 12px;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .legacy-input {
            border: 1px solid #bdbdbd;
            box-sizing: border-box;
            font-size: 13px;
            max-width: 460px;
            padding: 7px 8px;
            width: 100%;
        }

        .legacy-lists {
            border: 0;
            margin: 16px 0;
            padding: 0;
        }

        .legacy-lists legend {
            color: #555;
            font-size: 14px;
            font-weight: 700;
            margin-bottom: 8px;
            padding: 0;
        }

        .legacy-list-options {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .legacy-list-option {
            align-items: flex-start;
            display: flex;
            gap: 8px;
        }

        .legacy-button {
            background: #e5e5e5;
            border: 1px solid #a2a2a2;
            color: #222;
            cursor: pointer;
            font-size: 12px;
            padding: 6px 10px;
        }

        .legacy-error-box {
            background: #fbe9e9;
            border: 1px solid #c93e3e;
            color: #8c1f1f;
            font-size: 13px;
            margin-bottom: 12px;
            padding: 10px;
        }

        .legacy-error-box p {
            margin: 0 0 6px;
        }

        .legacy-error-box p:last-child {
            margin-bottom: 0;
        }

        .legacy-success {
            background: #ebf7ea;
            border: 1px solid #6ca56a;
            color: #215f20;
            font-size: 13px;
            margin-bottom: 12px;
            padding: 10px;
        }
    </style>
{% endblock %}
